diff -ruN a/models/marts/fct_monthly_active_customers.sql b/models/marts/fct_monthly_active_customers.sql
--- a/models/marts/fct_monthly_active_customers.sql	1970-01-01 07:30:00.000000000 +0730
+++ b/models/marts/fct_monthly_active_customers.sql	2026-10-25 17:14:00.910047821 +0800
@@ -0,0 +1,18 @@
+-- Reference solution for demo issue 1 (what a correct agent MR looks like).
+-- Active customer = a real (non-test) customer with at least one product event
+-- or completed order in the month.
+with activity as (
+    select customer_id, cast(date_trunc('month', event_date) as date) as activity_month
+    from {{ ref('stg_events') }}
+    union
+    select customer_id, cast(date_trunc('month', order_date) as date) as activity_month
+    from {{ ref('stg_orders') }}
+    where order_status = 'completed'
+)
+select
+    a.activity_month,
+    count(distinct a.customer_id) as active_customers
+from activity a
+join {{ ref('stg_customers') }} c using (customer_id)
+where not c.is_test_account
+group by a.activity_month
